  },
  "normals_tangents": {
   "status": "REQUIRED",
   "normals": "smooth angle-weighted vertex normals on the baked triangles (one smoothing group, no split normals), exported with the mesh and imported (not recomputed by the importer)",
   "tangents": "MikkTSpace-compatible (Blender calc_tangents / Unreal MikkTSpace), computed on the production UV",
   "importer": "no re-triangulation"
  },
  "LOD_HV1": {
   "status": "REQUIRED",
   "rule": "Decimate collapse of the baked triangles with vertex-group weights: 0 on the cuff + transition band and its one-ring (root junction protected), 0.35 on the lobe zone (auricle sheet below 30 % of the ear height), 1 elsewhere",
   "acceptance": [
    "root-region drift 0",
    "50 % and 25 % LODs: 0 self-intersections, 0 non-manifold edges, 0 zero-area triangles in the ear region"
   ],
   "forbidden": "unconstrained decimation"
  },
